# SpaceMolt Commander — Environment Variables Template
#
# IMPORTANT:
# 1. Copy this file to .env (it's in .gitignore)
# 2. Replace placeholder values with your actual API keys
# 3. Keep .env private — NEVER commit it!
# 4. Never share your API keys

# ============================================================================
# Cloud LLM API Keys
# ============================================================================

# Anthropic Claude (https://console.anthropic.com/)
# Get key from: Dashboard → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-

# OpenAI GPT (https://platform.openai.com/api-keys)
# Get key from: API Keys → Create new secret key
OPENAI_API_KEY=sk-

# Groq (https://console.groq.com/keys)
# Free tier available!
GROQ_API_KEY=gsk_

# Abacus.AI (https://abacus.ai/app/account)
# Only if you have a subscription
ABACUS_API_KEY=

# ============================================================================
# SpaceMolt Game Credentials
# ============================================================================

# SpaceMolt API Key (https://game.spacemolt.com)
# Get from: Account Settings → Developer/API
# Note: Usually handled interactively by the commander
SPACEMOLT_API_KEY=

# ============================================================================
# Optional: Local Ollama Configuration
# ============================================================================

# Ollama server address (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Number of GPU layers to use (0 = CPU only, leave empty for auto)
OLLAMA_NUM_GPU=

# ============================================================================
# Optional: Proxy Configuration
# ============================================================================

# If you're behind a corporate proxy:
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ============================================================================
# Optional: Debug & Logging
# ============================================================================

# Enable detailed logging (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# HOW TO USE THIS FILE:
# ============================================================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Edit .env with your keys:
#    nano .env

# 3. Load in Python (if using python-dotenv):
#    from dotenv import load_dotenv
#    load_dotenv()
#    import os
#    api_key = os.getenv("ANTHROPIC_API_KEY")

# 4. Or load in shell before running:
#    source .env
#    python -m spacemolt run "Your mission"

# ============================================================================
# SECURITY REMINDERS:
# ============================================================================

# ✓ DO:
#   - Keep .env in .gitignore
#   - Rotate keys regularly (every 3 months)
#   - Use separate keys for development vs production
#   - Set read-only permissions: chmod 600 .env

# ✗ DON'T:
#   - Commit .env to Git
#   - Share .env file with anyone
#   - Paste keys in chat or email
#   - Log API keys in output
#   - Leave keys in config.yaml
